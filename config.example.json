{
  "server": {
    "host": "127.0.0.1",
    "port": 8080
  },

  "work": {
    "start": "09:00",
    "end": "17:30",
    "break_minutes": 60,
    "auto_clock_in": true
  },

  "google": {
    "client_secret": "credentials.json",
    "token": "data/google_token.json",
    "calendar_ids": ["primary"]
  },

  "mail": {
    "provider": "google",
    "refresh_seconds": 300,
    "imap": {
      "host": "imap.gmail.com",
      "port": 993,
      "user": "you@example.com",
      "password": "",
      "folder": "INBOX"
    },
    "outlook": {
      "folder": "inbox"
    }
  },

  "calendar": {
    "provider": "google",
    "refresh_seconds": 600,
    "ics_urls": [
      "https://calendar.google.com/calendar/ical/xxxxx/private-xxxxx/basic.ics"
    ]
  },

  "redmine": {
    "enabled": true,
    "demo": true,
    "url": "https://redmine.example.com",
    "api_key": "",
    "days_ahead": 7,
    "include_overdue": true,
    "limit": 20,
    "verify_ssl": true,
    "refresh_seconds": 300
  }
}
